{
  "name": "telegram-app-pro",
  "version": "1.0.0",
  "description": "ProgramLive Telegram Mini App",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "load:100": "node tests/load-test.js --users=100 --ramp=60 --duration=600",
    "load:300": "node tests/load-test.js --users=300 --ramp=60 --duration=600",
    "verify": "npm run check && npm run test",
    "start": "node server.js",
    "check": "node tests/smoke.js",
    "test:smoke": "node tests/smoke.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
